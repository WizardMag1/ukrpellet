# Vercel Environment Variables — UkrPellet Lead System
# Copy these into Vercel Dashboard → Project Settings → Environment Variables

# ── Supabase (free auth + DB) ─────────────────────────────────────────────
# Project Settings → API → copy URL and anon key
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJ...

# ── Telegram Bot API (instant lead alerts on phone) ──────────────────────
# 1. Create a bot with @BotFather → /newbot → get token
# 2. Get your chat ID: @userinfobot → /start → copy chat.id
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# ── Resend Email API (lead forwarding to sales@ukrpellet.ua) ─────────────
# 1. Sign up at https://resend.com (free 100 emails/month)
# 2. Authenticate your domain ukrpellet.ua (or use your own verified domain)
# 3. Project Settings → API Keys → Create API Key
RESEND_API_KEY=re_aD8WHspd_ASEh9vxXsqbSfsCsm4XThGeH
LEAD_EMAIL_FROM=sales@ukrpellet.ua
LEAD_EMAIL_TO=sales@ukrpellet.ua
